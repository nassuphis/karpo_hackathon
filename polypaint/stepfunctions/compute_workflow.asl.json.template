{
  "Comment": "PolyPaint compute workflow \u2014 param_gen, coeffgen fan-out, lores solve, hires solve, calc.json save. Wrapped in Parallel to catch States.Runtime from parameter resolution errors.",
  "StartAt": "WorkflowWrapper",
  "States": {
    "WorkflowWrapper": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "PlanPhase",
          "States": {
            "PlanPhase": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${StatusFunctionArn}",
                "Payload": {
                  "action": "phase",
                  "job_id.$": "$.job_id",
                  "task_id.$": "$.task_id",
                  "run_id.$": "$.run_id",
                  "run_started_at_ms.$": "$.run_started_at_ms",
                  "mode.$": "$.mode",
                  "solver_mode.$": "$.params.solver_mode",
                  "phase": "plan",
                  "phase_label": "Plan",
                  "execution_arn.$": "$$.Execution.Id"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "RouteExecutionMethod"
            },
            "RouteExecutionMethod": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.params.execution_method",
                  "StringEquals": "fused_chunk_pipeline",
                  "Next": "DegreeProbePhase"
                }
              ],
              "Default": "BuildPlan"
            },
            "BuildPlan": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${PlanFunctionArn}",
                "Payload.$": "$"
              },
              "ResultSelector": {
                "plan.$": "$.Payload.body"
              },
              "ResultPath": "$.plan_raw",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "ParsePlan"
            },
            "ParsePlan": {
              "Type": "Pass",
              "Parameters": {
                "job_id.$": "$.job_id",
                "run_id.$": "$.run_id",
                "run_started_at_ms.$": "$.run_started_at_ms",
                "task_id.$": "$.task_id",
                "mode.$": "$.mode",
                "params.$": "$.params",
                "plan.$": "States.StringToJson($.plan_raw.plan)"
              },
              "Next": "ParamGenPhase"
            },
            "DegreeProbePhase": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${StatusFunctionArn}",
                "Payload": {
                  "action": "phase",
                  "job_id.$": "$.job_id",
                  "task_id.$": "$.task_id",
                  "run_id.$": "$.run_id",
                  "run_started_at_ms.$": "$.run_started_at_ms",
                  "mode.$": "$.mode",
                  "solver_mode.$": "$.params.solver_mode",
                  "phase": "degree_probe",
                  "phase_label": "Degree probe",
                  "execution_arn.$": "$$.Execution.Id"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException"
