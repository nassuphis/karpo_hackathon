                "step_start.$": "$$.Map.Item.Value.step_start",
                "step_count.$": "$$.Map.Item.Value.step_count",
                "N.$": "$.plan.compute.N",
                "n_threads.$": "$.plan.compute.coeffgen_threads",
                "function.$": "$.plan.pipeline.function",
                "coeff_program.$": "$.plan.pipeline.coeff_program",
