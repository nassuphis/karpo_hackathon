{
  "Comment": "PolyPaint render workflow — color, bilevel, coeff_bilevel pipelines. Wrapped in Parallel to catch States.Runtime from parameter resolution errors.",
  "StartAt": "WorkflowWrapper",
  "States": {

    "WorkflowWrapper": {
      "Type": "Parallel",
      "Branches": [{
        "StartAt": "CleanRender",
        "States": {

          "CleanRender": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": {
                "action": "phase",
                "job_id.$": "$.job_id",
                "task_id.$": "$.task_id",
                "run_id.$": "$.run_id",
                "run_started_at_ms.$": "$.run_started_at_ms",
                "mode.$": "$.mode",
                "phase": "plan",
                "phase_label": "Clean + plan"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "BuildPlan"
          },

          "BuildPlan": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${PlanFunctionArn}",
              "Payload.$": "$"
            },
            "ResultSelector": {
              "plan.$": "$.Payload.body"
            },
            "ResultPath": "$.plan_raw",
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ParsePlan"
          },

          "ParsePlan": {
            "Type": "Pass",
            "Parameters": {
              "job_id.$": "$.job_id",
              "run_id.$": "$.run_id",
              "run_started_at_ms.$": "$.run_started_at_ms",
              "task_id.$": "$.task_id",
              "mode.$": "$.mode",
              "params.$": "$.params",
              "plan.$": "States.StringToJson($.plan_raw.plan)"
            },
            "Next": "ModeChoice"
          },

          "ModeChoice": {
            "Type": "Choice",
            "Choices": [
              {"Variable": "$.mode", "StringEquals": "color", "Next": "ColorClipPhase"},
              {"Variable": "$.mode", "StringEquals": "bilevel", "Next": "BilevelRasterPhase"},
              {"Variable": "$.mode", "StringEquals": "coeff_bilevel", "Next": "CoeffRasterPhase"}
            ],
            "Default": "InnerFail"
          },

          "ColorClipPhase": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": {
                "action": "phase",
                "job_id.$": "$.job_id",
                "task_id.$": "$.task_id",
                "run_id.$": "$.run_id",
                "run_started_at_ms.$": "$.run_started_at_ms",
                "mode.$": "$.mode",
                "phase": "solve_score_clip",
                "phase_label": "Solve score: clip",
                "expected": 1,
                "subtask_prefix.$": "States.Format('render_{}_solve_score_clip', $.run_id)"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ColorClipTask"
          },

          "ColorClipTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${SolveProximityFunctionArn}",
              "Payload": {
                "phase": "clip",
                "job_id.$": "$.job_id",
                "degree.$": "$.plan.calc.degree",
                "metric.$": "$.plan.solve_score.metric",
                "solve_score_chain.$": "$.plan.solve_score.chain",
                "solve_score_threads.$": "$.plan.solve_score.threads",
                "lores_bin_key.$": "$.plan.calc.lores_bin_key",
                "lores_coeffs_key.$": "$.plan.calc.lores_coeffs_key",
                "lores_params_key.$": "$.plan.calc.lores_params_key",
                "n_coeffs.$": "$.plan.calc.n_coeffs",
                "root_transforms.$": "$.plan.params.root_transforms",
                "out_key.$": "$.plan.solve_score.clip_key",
                "task_id.$": "States.Format('render_{}_solve_score_clip', $.run_id)"
              }
            },
            "ResultSelector": {
              "parsed.$": "States.StringToJson($.Payload.body)"
            },
            "ResultPath": "$.solve_score_clip",
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ColorRasterPhase"
          },

          "ColorRasterPhase": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": {
                "action": "phase",
                "job_id.$": "$.job_id",
                "task_id.$": "$.task_id",
                "run_id.$": "$.run_id",
                "run_started_at_ms.$": "$.run_started_at_ms",
                "mode.$": "$.mode",
                "phase": "raster",
                "phase_label": "Raster",
                "expected.$": "$.plan.raster.item_count",
                "subtask_prefix.$": "States.Format('render_{}_raster_', $.run_id)"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ColorRasterMap"
          },

          "ColorRasterMap": {
            "Type": "Map",
            "ItemsPath": "$.plan.raster.map_items",
            "MaxConcurrencyPath": "$.plan.raster.workers",
            "ItemSelector": {
              "job_id.$": "$.job_id",
              "section_idx.$": "$$.Map.Item.Value.section_idx",
              "section_count.$": "$$.Map.Item.Value.section_count",
              "task_id.$": "States.Format('render_{}_raster_{}', $.run_id, $$.Map.Item.Value.section_idx)",
              "step_start.$": "$$.Map.Item.Value.step_start",
              "step_count.$": "$$.Map.Item.Value.step_count",
              "color_pipeline": "fused",
              "logical_section.$": "$.plan.raster.logical_section",
              "solve_source_manifest.$": "$.plan.solve_source_manifest",
              "n_coeffs.$": "$.plan.calc.n_coeffs",
              "width.$": "$.plan.grid.pix",
              "height.$": "$.plan.grid.pix",
              "tile_size.$": "$.plan.grid.tile_size",
              "n_tile_cols.$": "$.plan.grid.n_tile_cols",
              "n_tile_rows.$": "$.plan.grid.n_tile_rows",
              "center_re.$": "$.plan.viewport.center_re",
              "center_im.$": "$.plan.viewport.center_im",
              "scale.$": "$.plan.viewport.scale",
              "rotation.$": "$.plan.params.rotation",
              "degree.$": "$.plan.calc.degree",
              "color.$": "$.plan.params.color_mode",
              "match.$": "$.plan.params.match_mode",
              "palette.$": "$.plan.params.palette",
              "constant_color.$": "$.plan.params.constant_color",
              "root_transforms.$": "$.plan.params.root_transforms",
              "solve_score_clip_key.$": "$.plan.solve_score.clip_key",
              "solve_metric.$": "$.plan.solve_score.metric",
              "solve_score_chain.$": "$.plan.solve_score.chain",
              "solve_score_quantile.$": "$.plan.solve_score.quantile",
              "solve_score_omega.$": "$.plan.solve_score.omega",
              "solve_score_omega_enabled.$": "$.plan.solve_score.omega_enabled",
              "raster_function_name.$": "$.plan.raster.function_name",
              "raster_mt_threads.$": "$.plan.raster.threads",
              "raster_input_mode.$": "$.plan.raster.input_mode",
              "raster_sectioned_retries.$": "$.plan.raster.sectioned_retries",
              "associated_palette_mode.$": "$.plan.associated_palette.mode",
              "associated_palette_fragment_prefix.$": "$.plan.associated_palette.fragment_prefix",
              "associated_palette_grid_n.$": "$.plan.calc.N",
              "fragment_prefix.$": "$.plan.outputs.fragment_prefix"
            },
            "ItemProcessor": {
              "ProcessorConfig": {"Mode": "INLINE"},
              "StartAt": "ColorRasterWorker",
              "States": {
                "ColorRasterWorker": {
                  "Type": "Task",
                  "Resource": "arn:aws:states:::lambda:invoke",
                  "Parameters": { "FunctionName.$": "$.raster_function_name", "Payload.$": "$" },
                  "ResultPath": null,
                  "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
                  "End": true
                }
              }
            },
            "ResultPath": null,
            "Next": "ColorAssembleEncodePhase"
          },

          "ColorAssembleEncodePhase": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": {
                "action": "phase",
                "job_id.$": "$.job_id",
                "task_id.$": "$.task_id",
                "run_id.$": "$.run_id",
                "run_started_at_ms.$": "$.run_started_at_ms",
                "mode.$": "$.mode",
                "phase": "finalize_mt",
                "phase_label": "Assemble + encode",
                "expected": 1,
                "subtask_prefix.$": "States.Format('render_{}_finalize_mt', $.run_id)"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ColorAssembleEncodeTask"
          },

          "ColorAssembleEncodeTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${FinalizeMTFunctionArn}",
              "Payload": {
                "phase": "finalize_mt",
                "job_id.$": "$.job_id",
                "run_id.$": "$.run_id",
                "task_id.$": "States.Format('render_{}_finalize_mt', $.run_id)",
                "mode.$": "$.mode",
                "source_item_count.$": "$.plan.raster.item_count",
                "width.$": "$.plan.grid.pix",
                "height.$": "$.plan.grid.pix",
                "tile_size.$": "$.plan.grid.tile_size",
                "n_tile_cols.$": "$.plan.grid.n_tile_cols",
                "n_tile_rows.$": "$.plan.grid.n_tile_rows",
                "format.$": "$.plan.params.fmt",
                "quality.$": "$.plan.params.quality",
                "palette.$": "$.plan.params.palette",
                "background_color.$": "$.plan.outputs.metadata.background_color",
                "finalize_workers.$": "$.plan.finalize.workers",
                "render_execution.$": "$.plan.render_execution",
                "metadata.$": "$.plan.outputs.metadata",
                "image_key.$": "$.plan.outputs.image_key",
                "preview_key.$": "$.plan.outputs.preview_key",
                "meta_key.$": "$.plan.outputs.meta_key",
                "raw_key.$": "$.plan.outputs.raw_key",
                "raw_meta_key.$": "$.plan.outputs.raw_meta_key",
                "plan_params_digest.$": "$.plan.outputs.plan_params_digest",
                "clip_slots.$": "$.solve_score_clip.parsed.clip_slots",
                "score_program.$": "$.solve_score_clip.parsed.score_program",
                "chain_fingerprint.$": "$.solve_score_clip.parsed.chain_fingerprint",
                "fragment_prefix.$": "$.plan.outputs.fragment_prefix",
                "fragment_manifest": {
                  "version": 1,
                  "pair_encoding": "u32le_u8_v1",
                  "item_count.$": "$.plan.raster.item_count",
                  "fragment_prefix.$": "$.plan.outputs.fragment_prefix",
                  "chain_fingerprint.$": "$.plan.outputs.metadata.solve_score_chain_fingerprint"
                },
                "associated_palette.$": "$.plan.associated_palette",
                "associated_palette_grid_n.$": "$.plan.calc.N",
                "associated_palette_times.$": "$.plan.calc.times",
                "associated_palette_degree.$": "$.plan.calc.degree"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ReportDoneColor"
          },

          "ReportDoneColor": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": { "action": "done", "job_id.$": "$.job_id", "task_id.$": "$.task_id", "run_id.$": "$.run_id", "run_started_at_ms.$": "$.run_started_at_ms", "mode.$": "$.mode", "family.$": "$.plan.outputs.family", "artifact_id.$": "$.plan.outputs.artifact_id", "image_key.$": "$.plan.outputs.image_key" }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "InnerSucceed"
          },

          "BilevelRasterPhase": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": { "action": "phase", "job_id.$": "$.job_id", "task_id.$": "$.task_id", "run_id.$": "$.run_id", "run_started_at_ms.$": "$.run_started_at_ms", "mode.$": "$.mode", "phase": "bilevel_raster", "phase_label": "BiLevel raster", "expected.$": "$.plan.bilevel.item_count", "subtask_prefix.$": "States.Format('render_{}_bilevel_section_', $.run_id)" }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "BilevelRasterMap"
          },

          "BilevelRasterMap": {
            "Type": "Map",
            "ItemsPath": "$.plan.bilevel.section_items",
            "MaxConcurrency": 10,
            "ItemSelector": {
              "phase": "section_raster", "job_id.$": "$.job_id",
              "section_idx.$": "$$.Map.Item.Value.section_idx",
              "section_count.$": "$$.Map.Item.Value.section_count",
              "step_start.$": "$$.Map.Item.Value.step_start",
              "step_count.$": "$$.Map.Item.Value.step_count",
              "task_id.$": "States.Format('render_{}_bilevel_section_{}', $.run_id, $$.Map.Item.Value.section_idx)",
              "solve_source_manifest.$": "$.plan.solve_source_manifest",
              "section_bits_prefix.$": "$.plan.bilevel.section_bits_prefix",
              "width.$": "$.plan.grid.pix", "height.$": "$.plan.grid.pix",
              "center_re.$": "$.plan.viewport.center_re", "center_im.$": "$.plan.viewport.center_im", "scale.$": "$.plan.viewport.scale",
              "rotation.$": "$.plan.params.rotation", "degree.$": "$.plan.calc.degree",
              "root_transforms.$": "$.plan.params.root_transforms"
            },
            "ItemProcessor": { "ProcessorConfig": {"Mode": "INLINE"}, "StartAt": "BilevelRasterWorker", "States": { "BilevelRasterWorker": { "Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": { "FunctionName": "${BilevelFunctionArn}", "Payload.$": "$" }, "ResultPath": null, "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}], "End": true } } },
            "ResultPath": null, "Next": "BilevelFinalizePhase"
          },

          "BilevelFinalizePhase": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": { "action": "phase", "job_id.$": "$.job_id", "task_id.$": "$.task_id", "run_id.$": "$.run_id", "run_started_at_ms.$": "$.run_started_at_ms", "mode.$": "$.mode", "phase": "bilevel_finalize", "phase_label": "Assemble + encode", "expected": 1 }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "BilevelFinalizeTask"
          },

          "BilevelFinalizeTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${BilevelFunctionArn}",
              "Payload": {
                "phase": "finalize",
                "job_id.$": "$.job_id",
                "task_id.$": "States.Format('render_{}_bilevel_finalize', $.run_id)",
                "width.$": "$.plan.grid.pix",
                "height.$": "$.plan.grid.pix",
                "source_item_count.$": "$.plan.bilevel.item_count",
                "section_bits_prefix.$": "$.plan.bilevel.section_bits_prefix",
                "out_key.$": "$.plan.outputs.bilevel_key",
                "preview_key.$": "$.plan.outputs.preview_key",
                "metadata.$": "$.plan.outputs.metadata"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ReportDoneBilevel"
          },

          "ReportDoneBilevel": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": { "action": "done", "job_id.$": "$.job_id", "task_id.$": "$.task_id", "run_id.$": "$.run_id", "run_started_at_ms.$": "$.run_started_at_ms", "mode.$": "$.mode", "family.$": "$.plan.outputs.family", "artifact_id.$": "$.plan.outputs.artifact_id", "image_key.$": "$.plan.outputs.bilevel_key" }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "InnerSucceed"
          },

          "CoeffRasterPhase": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": { "action": "phase", "job_id.$": "$.job_id", "task_id.$": "$.task_id", "run_id.$": "$.run_id", "run_started_at_ms.$": "$.run_started_at_ms", "mode.$": "$.mode", "phase": "coeff_raster", "phase_label": "Coeffs raster", "expected.$": "$.plan.calc.n_chunks", "subtask_prefix.$": "States.Format('render_{}_coeff_bilevel_raster_', $.run_id)" }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "CoeffRasterMap"
          },

          "CoeffRasterMap": {
            "Type": "Map",
            "ItemsPath": "$.plan.physical_source_items",
            "MaxConcurrency": 10,
            "ItemSelector": {
              "phase": "coeff_raster", "job_id.$": "$.job_id",
              "chunk_idx.$": "$$.Map.Item.Value.chunk_idx",
              "task_id.$": "States.Format('render_{}_coeff_bilevel_raster_{}', $.run_id, $$.Map.Item.Value.chunk_idx)",
              "coeffs_key.$": "States.ArrayGetItem($.plan.calc.coeffs_keys, $$.Map.Item.Value.chunk_idx)",
              "width.$": "$.plan.grid.pix", "height.$": "$.plan.grid.pix",
              "tile_size.$": "$.plan.grid.tile_size", "n_tile_cols.$": "$.plan.grid.n_tile_cols", "n_tile_rows.$": "$.plan.grid.n_tile_rows",
              "center_re.$": "$.plan.viewport.center_re", "center_im.$": "$.plan.viewport.center_im", "scale.$": "$.plan.viewport.scale",
              "rotation.$": "$.plan.params.rotation", "degree.$": "$.plan.calc.degree", "n_coeffs.$": "$.plan.calc.n_coeffs",
              "root_transforms.$": "$.plan.params.root_transforms"
            },
            "ItemProcessor": { "ProcessorConfig": {"Mode": "INLINE"}, "StartAt": "CoeffRasterWorker", "States": { "CoeffRasterWorker": { "Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": { "FunctionName": "${BilevelFunctionArn}", "Payload.$": "$" }, "ResultPath": null, "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}], "End": true } } },
            "ResultPath": null, "Next": "CoeffMergePhase"
          },

          "CoeffMergePhase": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": { "action": "phase", "job_id.$": "$.job_id", "task_id.$": "$.task_id", "run_id.$": "$.run_id", "run_started_at_ms.$": "$.run_started_at_ms", "mode.$": "$.mode", "phase": "coeff_merge", "phase_label": "Coeffs merge", "expected.$": "$.plan.grid.n_tiles", "subtask_prefix.$": "States.Format('render_{}_coeff_bilevel_merge_', $.run_id)" }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "CoeffMergeMap"
          },

          "CoeffMergeMap": {
            "Type": "Map",
            "ItemsPath": "$.plan.tile_items",
            "MaxConcurrency": 32,
            "ItemSelector": {
              "phase": "merge", "job_id.$": "$.job_id",
              "tile_idx.$": "$$.Map.Item.Value.tile_idx",
              "task_id.$": "States.Format('render_{}_coeff_bilevel_merge_{}', $.run_id, $$.Map.Item.Value.tile_idx)",
              "n_chunks.$": "$.plan.calc.n_chunks", "n_tile_cols.$": "$.plan.grid.n_tile_cols", "n_tile_rows.$": "$.plan.grid.n_tile_rows",
              "width.$": "$.plan.grid.pix", "height.$": "$.plan.grid.pix", "tile_size.$": "$.plan.grid.tile_size",
              "bits_prefix": "coeff_bits", "tile_prefix": "coeff", "task_prefix": "coeff_bilevel_merge"
            },
            "ItemProcessor": { "ProcessorConfig": {"Mode": "INLINE"}, "StartAt": "CoeffMergeWorker", "States": { "CoeffMergeWorker": { "Type": "Task", "Resource": "arn:aws:states:::lambda:invoke", "Parameters": { "FunctionName": "${BilevelFunctionArn}", "Payload.$": "$" }, "ResultPath": null, "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}], "End": true } } },
            "ResultPath": null, "Next": "CoeffStitchPhase"
          },

          "CoeffStitchPhase": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": { "action": "phase", "job_id.$": "$.job_id", "task_id.$": "$.task_id", "run_id.$": "$.run_id", "run_started_at_ms.$": "$.run_started_at_ms", "mode.$": "$.mode", "phase": "coeff_stitch", "phase_label": "Coeffs stitch", "expected": 1 }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "CoeffStitchTask"
          },

          "CoeffStitchTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${BilevelStitchFunctionArn}",
              "Payload": { "job_id.$": "$.job_id", "task_id.$": "States.Format('render_{}_coeff_bilevel_stitch', $.run_id)", "n_tile_cols.$": "$.plan.grid.n_tile_cols", "n_tile_rows.$": "$.plan.grid.n_tile_rows", "width.$": "$.plan.grid.pix", "height.$": "$.plan.grid.pix", "tile_size.$": "$.plan.grid.tile_size", "out_key.$": "$.plan.outputs.coeff_bilevel_key", "preview_key.$": "$.plan.outputs.preview_key", "metadata.$": "$.plan.outputs.metadata", "tile_prefix": "coeff" }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "CoeffPreviewTask"
          },

          "CoeffPreviewTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${PreviewFunctionArn}",
              "Payload": {
                "job_id.$": "$.job_id",
                "source_key.$": "$.plan.outputs.coeff_bilevel_key",
                "preview_key.$": "$.plan.outputs.preview_key",
                "task_id.$": "States.Format('render_{}_preview_coeffs', $.run_id)"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ReportDoneCoeffBilevel"
          },

          "ReportDoneCoeffBilevel": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": { "action": "done", "job_id.$": "$.job_id", "task_id.$": "$.task_id", "run_id.$": "$.run_id", "run_started_at_ms.$": "$.run_started_at_ms", "mode.$": "$.mode", "family.$": "$.plan.outputs.family", "artifact_id.$": "$.plan.outputs.artifact_id", "image_key.$": "$.plan.outputs.coeff_bilevel_key" }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "InnerSucceed"
          },

          "InnerSucceed": { "Type": "Succeed" },
          "InnerFail": { "Type": "Fail", "Error": "InvalidMode", "Cause": "Unknown render mode" }
        }
      }],
      "ResultPath": null,
      "Catch": [{
        "ErrorEquals": ["States.ALL"],
        "ResultPath": "$.error_info",
        "Next": "ReportError"
      }],
      "Next": "Succeed"
    },

    "Succeed": { "Type": "Succeed" },

    "ReportError": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${StatusFunctionArn}",
        "Payload": {
          "action": "error",
          "job_id.$": "$.job_id",
          "task_id.$": "$.task_id",
          "run_id.$": "$.run_id",
          "run_started_at_ms.$": "$.run_started_at_ms",
          "mode.$": "$.mode",
          "Error.$": "$.error_info.Error",
          "Cause.$": "$.error_info.Cause"
        }
      },
      "ResultPath": null,
      "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
      "Next": "Fail"
    },

    "Fail": {
      "Type": "Fail",
      "Error": "RenderFailed",
      "Cause": "See DDB run row for details"
    }
  }
}
