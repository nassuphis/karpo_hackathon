              "Parameters": {
                "job_id.$": "$.job_id",
                "run_id.$": "$.run_id",
                "run_started_at_ms.$": "$.run_started_at_ms",
                "task_id.$": "$.task_id",
                "mode.$": "$.mode",
                "params.$": "$.params",
                "plan.$": "$.plan",
                "post.$": "States.StringToJson($.post_raw.post)"
