{
  "Comment": "PolyPaint palette workflow \u2014 reusable full-resolution palette artifacts with pass-0 image assembly. Wrapped in Parallel to catch States.Runtime from parameter resolution errors.",
  "StartAt": "WorkflowWrapper",
  "States": {
    "WorkflowWrapper": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "BuildPlanPhase",
          "States": {
            "BuildPlanPhase": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${StatusFunctionArn}",
                "Payload": {
                  "action": "phase",
                  "job_id.$": "$.job_id",
                  "task_id.$": "$.task_id",
                  "run_id.$": "$.run_id",
                  "mode.$": "$.mode",
                  "phase": "plan",
                  "phase_label": "Clean + plan",
                  "execution_arn.$": "$$.Execution.Id"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "BuildPlan"
            },
            "BuildPlan": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${PlanFunctionArn}",
                "Payload.$": "$"
              },
              "ResultSelector": {
                "plan.$": "$.Payload.body"
              },
              "ResultPath": "$.plan_raw",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "ParsePlan"
            },
            "ParsePlan": {
              "Type": "Pass",
              "Parameters": {
                "job_id.$": "$.job_id",
                "run_id.$": "$.run_id",
                "task_id.$": "$.task_id",
                "mode.$": "$.mode",
                "params.$": "$.params",
                "plan.$": "States.StringToJson($.plan_raw.plan)"
              },
              "Next": "ExtractActionChoice"
            },
            "ExtractActionChoice": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.plan.extract.action",
                  "StringEquals": "done",
                  "Next": "ReportDone"
                },
                {
                  "Variable": "$.plan.extract.action",
                  "StringEquals": "attach",
                  "Next": "AttachAssociatedPalettePhase"
                },
                {
                  "Variable": "$.plan.extract.action",
                  "StringEquals": "generate_reuse",
                  "Next": "PaletteChunkPhase"
                }
              ],
              "Default": "SolveScoreClipPhase"
            },
            "SolveScoreClipPhase": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${StatusFunctionArn}",
                "Payload": {
                  "action": "phase",
                  "job_id.$": "$.job_id",
                  "task_id.$": "$.task_id",
                  "run_id.$": "$.run_id",
                  "mode.$": "$.mode",
                  "phase": "solve_score_clip",
                  "phase_label": "Solve score: clip",
                  "expected": 1,
                  "execution_arn.$": "$$.Execution.Id"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "SolveScoreClipTask"
            },
            "SolveScoreClipTask": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${SolveProximityFunctionArn}",
                "Payload": {
                  "phase": "clip",
                  "job_id.$": "$.job_id",
                  "degree.$": "$.plan.calc.degree",
                  "metric.$": "$.plan.solve_score.metric",
                  "solve_score_chain.$": "$.plan.solve_score.chain",
                  "solve_score_program_source_text.$": "$.plan.solve_score.source_text",
                  "solve_score_quantile.$": "$.plan.solve_score.quantile",
                  "solve_score_omega.$": "$.plan.solve_score.omega",
                  "solve_score_omega_enabled.$": "$.plan.solve_score.omega_enabled",
                  "solve_score_threads.$": "$.plan.params.solve_score_threads",
                  "lores_bin_key.$": "$.plan.calc.lores_bin_key",
                  "lores_coeffs_key.$": "$.plan.calc.lores_coeffs_key",
                  "lores_params_key.$": "$.plan.calc.lores_params_key",
                  "n_coeffs.$": "$.plan.calc.n_coeffs",
                  "root_transforms.$": "$.plan.params.root_transforms",
                  "out_key.$": "$.plan.solve_score.clip_key",
                  "task_id.$": "States.Format('palette_{}_solve_score_clip', $.run_id)"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "SolveScoreHistPhase"
            },
            "SolveScoreHistPhase": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${StatusFunctionArn}",
                "Payload": {
                  "action": "phase",
                  "job_id.$": "$.job_id",
                  "task_id.$": "$.task_id",
                  "run_id.$": "$.run_id",
                  "mode.$": "$.mode",
                  "phase": "solve_score_hist",
                  "phase_label": "Solve score: hist",
                  "expected.$": "$.plan.calc.n_sections",
                  "subtask_prefix.$": "States.Format('palette_{}_solve_score_hist_section_', $.run_id)",
                  "execution_arn.$": "$$.Execution.Id"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "SolveScoreHistMap"
            },
            "SolveScoreHistMap": {
              "Type": "Map",
              "ItemsPath": "$.plan.section_items",
              "MaxConcurrency": 10,
              "ItemSelector": {
                "phase": "hist",
                "job_id.$": "$.job_id",
                "section_idx.$": "$$.Map.Item.Value.section_idx",
                "metric.$": "$.plan.solve_score.metric",
                "solve_score_chain.$": "$.plan.solve_score.chain",
                "solve_score_program_source_text.$": "$.plan.solve_score.source_text",
                "solve_score_quantile.$": "$.plan.solve_score.quantile",
                "solve_score_omega.$": "$.plan.solve_score.omega",
                "solve_score_omega_enabled.$": "$.plan.solve_score.omega_enabled",
                "solve_score_threads.$": "$.plan.params.solve_score_threads",
                "solve_score_hist_input_mode.$": "$.plan.params.solve_score_hist_input_mode",
                "solve_score_hist_retries.$": "$.plan.params.solve_score_hist_retries",
                "logical_section.$": "$.plan.logical_section",
                "solve_source_manifest_key.$": "$.plan.solve_source_manifest_key",
                "prelude_rows.$": "$.plan.solve_score.prelude_rows",
                "score_coeff_prelude_rows.$": "$.plan.solve_score.score_coeff_prelude_rows",
                "score_param_prelude_rows.$": "$.plan.solve_score.score_param_prelude_rows",
                "bin_key.$": "$$.Map.Item.Value.bin_key",
                "coeffs_key.$": "$$.Map.Item.Value.coeffs_key",
                "coeffs_bin_size.$": "$$.Map.Item.Value.coeffs_bin_size",
                "params_key.$": "$$.Map.Item.Value.params_key",
                "params_step_start.$": "$$.Map.Item.Value.params_step_start",
                "params_step_count.$": "$$.Map.Item.Value.params_step_count",
                "step_start.$": "$$.Map.Item.Value.step_start",
                "step_count.$": "$$.Map.Item.Value.step_count",
                "n_coeffs.$": "$.plan.calc.n_coeffs",
                "degree.$": "$.plan.calc.degree",
                "clip_key.$": "$.plan.solve_score.clip_key",
                "hist_bins": 100,
                "root_transforms.$": "$.plan.params.root_transforms",
                "out_key.$": "States.Format('{}section_{}_hist.json', $.plan.solve_score.hist_prefix, $$.Map.Item.Value.section_idx)",
                "task_id.$": "States.Format('palette_{}_solve_score_hist_section_{}', $.run_id, $$.Map.Item.Value.section_idx)"
              },
              "ItemProcessor": {
                "ProcessorConfig": {
                  "Mode": "INLINE"
                },
                "StartAt": "SolveHistWorker",
                "States": {
                  "SolveHistWorker": {
                    "Type": "Task",
                    "Resource": "arn:aws:states:::lambda:invoke",
                    "Parameters": {
                      "FunctionName": "${SolveProximityFunctionArn}",
                      "Payload.$": "$"
                    },
                    "ResultPath": null,
                    "Retry": [
                      {
                        "ErrorEquals": [
                          "Lambda.ServiceException",
                          "Lambda.AWSLambdaException",
                          "Lambda.SdkClientException",
                          "Lambda.TooManyRequestsException"
                        ],
                        "IntervalSeconds": 2,
                        "BackoffRate": 2.0,
                        "MaxAttempts": 3
                      }
                    ],
                    "End": true
                  }
                }
              },
              "ResultPath": null,
              "Next": "SolveScoreMergePhase"
            },
            "SolveScoreMergePhase": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${StatusFunctionArn}",
                "Payload": {
                  "action": "phase",
                  "job_id.$": "$.job_id",
                  "task_id.$": "$.task_id",
                  "run_id.$": "$.run_id",
                  "mode.$": "$.mode",
                  "phase": "solve_score_merge",
                  "phase_label": "Solve score: merge",
                  "expected": 1,
                  "execution_arn.$": "$$.Execution.Id"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "SolveScoreMergeTask"
            },
            "SolveScoreMergeTask": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${SolveProximityFunctionArn}",
                "Payload": {
                  "phase": "merge",
                  "job_id.$": "$.job_id",
                  "n_chunks.$": "$.plan.calc.n_sections",
                  "metric.$": "$.plan.solve_score.metric",
                  "solve_score_chain.$": "$.plan.solve_score.chain",
                  "solve_score_program_source_text.$": "$.plan.solve_score.source_text",
                  "solve_score_quantile.$": "$.plan.solve_score.quantile",
                  "solve_score_omega.$": "$.plan.solve_score.omega",
                  "solve_score_omega_enabled.$": "$.plan.solve_score.omega_enabled",
                  "solve_score_threads.$": "$.plan.params.solve_score_threads",
                  "solve_score_merge_workers.$": "$.plan.params.solve_score_merge_workers",
                  "hist_prefix.$": "$.plan.solve_score.hist_prefix",
                  "clip_key.$": "$.plan.solve_score.clip_key",
                  "out_key.$": "$.plan.solve_score.bins_key",
                  "task_id.$": "States.Format('palette_{}_solve_score_merge', $.run_id)"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "PaletteChunkPhase"
            },
            "PaletteChunkPhase": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${StatusFunctionArn}",
                "Payload": {
                  "action": "phase",
                  "job_id.$": "$.job_id",
                  "task_id.$": "$.task_id",
                  "run_id.$": "$.run_id",
                  "mode.$": "$.mode",
                  "phase": "palette_chunk",
                  "phase_label": "Palette: chunk",
                  "expected.$": "$.plan.calc.n_sections",
                  "subtask_prefix.$": "States.Format('palette_{}_section_', $.run_id)",
                  "execution_arn.$": "$$.Execution.Id"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "PaletteChunkMap"
            },
            "PaletteChunkMap": {
              "Type": "Map",
              "ItemsPath": "$.plan.section_items",
              "MaxConcurrencyPath": "$.plan.params.palette_chunk_workers",
              "ItemSelector": {
                "job_id.$": "$.job_id",
                "section_idx.$": "$$.Map.Item.Value.section_idx",
                "bin_key.$": "$$.Map.Item.Value.bin_key",
                "bin_size.$": "$$.Map.Item.Value.bin_size",
                "coeffs_key.$": "$$.Map.Item.Value.coeffs_key",
                "coeffs_bin_size.$": "$$.Map.Item.Value.coeffs_bin_size",
                "params_key.$": "$$.Map.Item.Value.params_key",
                "params_step_start.$": "$$.Map.Item.Value.params_step_start",
                "params_step_count.$": "$$.Map.Item.Value.params_step_count",
                "n_coeffs.$": "$.plan.calc.n_coeffs",
                "step_start.$": "$$.Map.Item.Value.step_start",
                "step_count.$": "$$.Map.Item.Value.step_count",
                "degree.$": "$.plan.calc.degree",
                "metric.$": "$.plan.solve_score.metric",
                "solve_score_chain.$": "$.plan.solve_score.chain",
                "solve_score_program_source_text.$": "$.plan.solve_score.source_text",
                "solve_score_quantile.$": "$.plan.solve_score.quantile",
                "solve_score_omega.$": "$.plan.solve_score.omega",
                "solve_score_omega_enabled.$": "$.plan.solve_score.omega_enabled",
                "solve_score_chain_fingerprint.$": "$.plan.solve_score.chain_fingerprint",
                "solve_score_spec_version.$": "$.plan.solve_score.spec_version",
                "score_output_channel_count.$": "$.plan.solve_score.output_channel_count",
                "score_output_channels.$": "$.plan.solve_score.output_channels",
                "score_output_has_explicit_outputs.$": "$.plan.solve_score.has_explicit_outputs",
                "color_interpretation.$": "$.plan.params.color_interpretation",
                "root_transforms.$": "$.plan.params.root_transforms",
                "palette_chunk_threads.$": "$.plan.params.palette_chunk_threads",
                "palette_chunk_input_mode.$": "$.plan.params.palette_chunk_input_mode",
                "palette_chunk_retries.$": "$.plan.params.palette_chunk_retries",
                "palette_chunk_workers.$": "$.plan.params.palette_chunk_workers",
                "logical_section.$": "$.plan.logical_section",
                "solve_source_manifest_key.$": "$.plan.solve_source_manifest_key",
                "prelude_rows.$": "$.plan.solve_score.prelude_rows",
                "score_coeff_prelude_rows.$": "$.plan.solve_score.score_coeff_prelude_rows",
                "score_param_prelude_rows.$": "$.plan.solve_score.score_param_prelude_rows",
                "solve_score_bins_key.$": "$.plan.solve_score.bins_key",
                "score_key.$": "States.Format('{}{}.bin', $.plan.outputs.section_scores_prefix, $$.Map.Item.Value.section_idx)",
                "palette_bins_key.$": "States.Format('{}{}.bin', $.plan.outputs.section_bins_prefix, $$.Map.Item.Value.section_idx)",
                "meta_key.$": "States.Format('{}{}.json', $.plan.outputs.section_meta_prefix, $$.Map.Item.Value.section_idx)",
                "task_id.$": "States.Format('palette_{}_section_{}', $.run_id, $$.Map.Item.Value.section_idx)"
              },
              "ItemProcessor": {
                "ProcessorConfig": {
                  "Mode": "INLINE"
                },
                "StartAt": "PaletteChunkWorker",
                "States": {
                  "PaletteChunkWorker": {
                    "Type": "Task",
                    "Resource": "arn:aws:states:::lambda:invoke",
                    "Parameters": {
                      "FunctionName": "${PaletteChunkFunctionArn}",
                      "Payload.$": "$"
                    },
                    "ResultPath": null,
                    "Retry": [
                      {
                        "ErrorEquals": [
                          "Lambda.ServiceException",
                          "Lambda.AWSLambdaException",
                          "Lambda.SdkClientException",
                          "Lambda.TooManyRequestsException"
                        ],
                        "IntervalSeconds": 2,
                        "BackoffRate": 2.0,
                        "MaxAttempts": 3
                      }
                    ],
                    "End": true
                  }
                }
              },
              "ResultPath": null,
              "Next": "PaletteFinalizePhase"
            },
            "PaletteFinalizePhase": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${StatusFunctionArn}",
                "Payload": {
                  "action": "phase",
                  "job_id.$": "$.job_id",
                  "task_id.$": "$.task_id",
                  "run_id.$": "$.run_id",
                  "mode.$": "$.mode",
                  "phase": "palette_finalize",
                  "phase_label": "Palette: finalize",
                  "expected": 1,
                  "execution_arn.$": "$$.Execution.Id"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "PaletteFinalizeTask"
            },
            "PaletteFinalizeTask": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${PaletteFinalizeFunctionArn}",
                "Payload": {
                  "job_id.$": "$.job_id",
                  "run_id.$": "$.run_id",
                  "task_id.$": "States.Format('palette_{}_finalize', $.run_id)",
                  "palette_id.$": "$.plan.palette_id",
                  "N.$": "$.plan.calc.N",
                  "times.$": "$.plan.calc.times",
                  "degree.$": "$.plan.calc.degree",
                  "metric.$": "$.plan.solve_score.metric",
                  "palette.$": "$.plan.params.palette",
                  "palette_display_name.$": "$.plan.params.palette_display_name",
                  "solve_score_chain.$": "$.plan.solve_score.chain",
                  "solve_score_program_source_text.$": "$.plan.solve_score.source_text",
                  "solve_score_quantile.$": "$.plan.solve_score.quantile",
                  "solve_score_omega.$": "$.plan.solve_score.omega",
                  "solve_score_omega_enabled.$": "$.plan.solve_score.omega_enabled",
                  "score_output_channel_count.$": "$.plan.solve_score.output_channel_count",
                  "score_output_channels.$": "$.plan.solve_score.output_channels",
                  "color_interpretation.$": "$.plan.params.color_interpretation",
                  "root_transforms.$": "$.plan.params.root_transforms",
                  "root_program_source_text.$": "$.plan.params.root_program_source_text",
                  "root_program.$": "$.plan.params.root_program",
                  "root_program_fingerprint.$": "$.plan.params.root_program_fingerprint",
                  "root_spec_version.$": "$.plan.params.root_spec_version",
                  "image_key.$": "$.plan.outputs.image_key",
                  "preview_key.$": "$.plan.outputs.preview_key",
                  "meta_key.$": "$.plan.outputs.meta_key",
                  "raw_key.$": "$.plan.outputs.raw_key",
                  "raw_meta_key.$": "$.plan.outputs.raw_meta_key",
                  "raw_layout.$": "$.plan.outputs.raw_layout",
                  "raw_channels.$": "$.plan.outputs.raw_channels",
                  "palette_variant_fingerprint.$": "$.plan.outputs.palette_variant_fingerprint",
                  "palette_variant_spec_version.$": "$.plan.outputs.palette_variant_spec_version",
                  "chunks_prefix.$": "$.plan.outputs.chunks_prefix",
                  "section_scores_prefix.$": "$.plan.outputs.section_scores_prefix",
                  "section_bins_prefix.$": "$.plan.outputs.section_bins_prefix",
                  "section_meta_prefix.$": "$.plan.outputs.section_meta_prefix",
                  "solve_score_prefix.$": "$.plan.solve_score.hist_prefix",
                  "solve_score_clip_key.$": "$.plan.solve_score.clip_key",
                  "solve_score_bins_key.$": "$.plan.solve_score.bins_key",
                  "cleanup_solve_score_scratch.$": "$.plan.solve_score.cleanup_scratch",
                  "source_color_artifact_id.$": "$.plan.extract.source_artifact_id"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "PostFinalizeAttachChoice"
            },
            "PostFinalizeAttachChoice": {
              "Type": "Choice",
              "Choices": [
                {
                  "Variable": "$.plan.attach.enabled",
                  "BooleanEquals": true,
                  "Next": "AttachAssociatedPalettePhase"
                }
              ],
              "Default": "ReportDone"
            },
            "AttachAssociatedPalettePhase": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${StatusFunctionArn}",
                "Payload": {
                  "action": "phase",
                  "job_id.$": "$.job_id",
                  "task_id.$": "$.task_id",
                  "run_id.$": "$.run_id",
                  "mode.$": "$.mode",
                  "phase": "attach_associated_palette",
                  "phase_label": "Attach palette",
                  "expected": 1,
                  "execution_arn.$": "$$.Execution.Id"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "AttachAssociatedPaletteTask"
            },
            "AttachAssociatedPaletteTask": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${AttachPaletteFunctionArn}",
                "Payload": {
                  "job_id.$": "$.job_id",
                  "task_id.$": "States.Format('palette_{}_attach', $.run_id)",
                  "artifact_id.$": "$.plan.attach.artifact_id",
                  "associated_palette_mode.$": "$.plan.attach.mode",
                  "associated_palette_id.$": "$.plan.attach.palette_id",
                  "associated_palette_display_name.$": "$.plan.attach.display_name",
                  "associated_palette_image_key.$": "$.plan.attach.image_key",
                  "associated_palette_preview_key.$": "$.plan.attach.preview_key",
                  "associated_palette_palette.$": "$.plan.attach.palette",
                  "associated_palette_metric.$": "$.plan.attach.metric",
                  "associated_palette_score_chain.$": "$.plan.attach.score_chain",
                  "associated_palette_quantile.$": "$.plan.attach.quantile",
                  "associated_palette_omega.$": "$.plan.attach.omega",
                  "associated_palette_omega_enabled.$": "$.plan.attach.omega_enabled",
                  "associated_palette_color_interpretation.$": "$.plan.attach.color_interpretation",
                  "associated_palette_raw_key.$": "$.plan.attach.raw_key",
                  "associated_palette_raw_meta_key.$": "$.plan.attach.raw_meta_key",
                  "associated_palette_meta_key.$": "$.plan.attach.meta_key"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "ReportDone"
            },
            "ReportDone": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${StatusFunctionArn}",
                "Payload": {
                  "action": "done",
                  "job_id.$": "$.job_id",
                  "task_id.$": "$.task_id",
                  "run_id.$": "$.run_id",
                  "mode.$": "$.mode",
                  "family": "palette",
                  "artifact_id.$": "$.plan.attach.artifact_id",
                  "palette_id.$": "$.plan.palette_id",
                  "image_key.$": "$.plan.outputs.image_key",
                  "execution_arn.$": "$$.Execution.Id"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException",
                    "Lambda.TooManyRequestsException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "InnerSucceed"
            },
            "InnerSucceed": {
              "Type": "Succeed"
            }
          }
        }
      ],
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_info",
          "Next": "ReportError"
        }
      ],
      "Next": "Succeed"
    },
    "Succeed": {
      "Type": "Succeed"
    },
    "ReportError": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${StatusFunctionArn}",
        "Payload": {
          "action": "error",
          "job_id.$": "$.job_id",
          "task_id.$": "$.task_id",
          "run_id.$": "$.run_id",
          "mode.$": "$.mode",
          "Error.$": "$.error_info.Error",
          "Cause.$": "$.error_info.Cause",
          "execution_arn.$": "$$.Execution.Id"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2.0,
          "MaxAttempts": 3
        }
      ],
      "Next": "Fail"
    },
    "Fail": {
      "Type": "Fail",
      "Error": "PaletteFailed",
      "Cause": "See DDB run row for details"
    }
  }
}
