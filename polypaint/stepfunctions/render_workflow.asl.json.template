            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ReportDoneCoeffBilevel"
          },

          "ReportDoneCoeffBilevel": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": { "action": "done", "job_id.$": "$.job_id", "task_id.$": "$.task_id", "run_id.$": "$.run_id", "run_started_at_ms.$": "$.run_started_at_ms", "mode.$": "$.mode", "family.$": "$.plan.outputs.family", "artifact_id.$": "$.plan.outputs.artifact_id", "image_key.$": "$.plan.outputs.coeff_bilevel_key" }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "InnerSucceed"
          },

          "InnerSucceed": { "Type": "Succeed" },
          "InnerFail": { "Type": "Fail", "Error": "InvalidMode", "Cause": "Unknown render mode" }
        }
      }],
      "ResultPath": null,
      "Catch": [{
        "ErrorEquals": ["States.ALL"],
        "ResultPath": "$.error_info",
        "Next": "ReportError"
      }],
      "Next": "Succeed"
    },

    "Succeed": { "Type": "Succeed" },

    "ReportError": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${StatusFunctionArn}",
        "Payload": {
          "action": "error",
          "job_id.$": "$.job_id",
          "task_id.$": "$.task_id",
          "run_id.$": "$.run_id",
          "run_started_at_ms.$": "$.run_started_at_ms",
          "mode.$": "$.mode",
          "Error.$": "$.error_info.Error",
          "Cause.$": "$.error_info.Cause"
        }
      },
      "ResultPath": null,
      "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
      "Next": "Fail"
    },

    "Fail": {
      "Type": "Fail",
      "Error": "RenderFailed",
      "Cause": "See DDB run row for details"
    }
  }
}
