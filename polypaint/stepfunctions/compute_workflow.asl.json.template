                }
              },
              "ResultSelector": {
                "post.$": "$.Payload.body"
              },
              "ResultPath": "$.post_raw",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "ParsePostCoeffgen"
            },
            "ParsePostCoeffgen": {
