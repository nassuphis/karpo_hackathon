  Decision = c("D1 buildless, 13 parts", "D2 manifest deployer",
               "D3 41 small Lambdas", "D4 C core, generated mirrors",
               "D5 four DSLs, text-first", "D6 fingerprint cache",
               "D7 SFN + polling", "D8 verification stack",
               "D9 native lib exposure", "D10 adversarial reviews"),
  Call = c("Keep; lint gate still open", "DONE + stable",
           "Keep; layer is hygiene now", "DONE (8 generators)",
           "DONE beyond proposal", "Keep; bump procedure only",
           "Unchanged: the open gap", "Meta-gated + oracles",
           "Settled", "Keep the cadence"),
  Risk.if.ignored = c("unexecuted-path bugs", "(retired)",
                      "mid-deploy skew (contained)", "(retired)",
                      "dead chip code lingers", "undocumented bump",
                      "polling UX ceiling", "property leg missing",
                      "(retired)", "drift returns quietly")
)
