                  "coeff_program_chain.$": "$.params.coeff_program_chain",
                  "coeff_program_source_text.$": "$.params.coeff_program_source_text",
                  "cfpv.$": "$.params.cfpv",
                  "solver_mode.$": "$.params.solver_mode",
                  "N.$": "$.params.N",
                  "times.$": "$.params.times",
                  "n_chunks.$": "$.params.n_chunks",
                  "fused_threads.$": "$.params.fused_threads",
