<<setup, echo=FALSE>>=
knitr::opts_chunk$set(echo = FALSE, fig.align = "center", dev = "pdf",
                      fig.pos = "ht")
ACC <- "#E94560"; INK <- "#16213E"; PAPER <- "#F7F7F9"; LINE <- "#3A3A44"
SOFT <- "#9aa0b0"
wf_new <- function() {
  par(mar = c(0.2, 0.2, 0.2, 0.2))
  plot.new(); plot.window(xlim = c(0, 100), ylim = c(0, 100))
}
wf_box <- function(x, y, w, h, label = "", fill = PAPER, border = LINE,
                   cex = 0.62, tcol = "#16161D", lwd = 1, lty = 1,
                   align = "c", font = 1) {
  rect(x, y, x + w, y + h, col = fill, border = border, lwd = lwd, lty = lty)
  if (nzchar(label)) {
    if (align == "c") text(x + w/2, y + h/2, label, cex = cex, col = tcol, font = font)
    else text(x + 1.6, y + h/2, label, cex = cex, col = tcol, adj = c(0, 0.5), font = font)
  }
}
wf_chip <- function(x, y, label, w = NULL, h = 5, fill = "#EDF0FA",
                    border = "#7A86A8", cex = 0.5) {
  if (is.null(w)) w <- 3.4 + 1.55 * nchar(label)
  rect(x, y, x + w, y + h, col = fill, border = border, lwd = 0.9)
  text(x + w/2, y + h/2, label, cex = cex, col = "#222633", family = "mono")
  invisible(x + w + 1.4)
}
wf_arrow <- function(x1, y1, x2, y2, col = LINE, lwd = 1.2, code = 2) {
  arrows(x1, y1, x2, y2, length = 0.055, lwd = lwd, col = col, code = code)
}
wf_note <- function(x, y, label, cex = 0.52, col = "#555a6a", adj = c(0, 0.5)) {
  text(x, y, label, cex = cex, col = col, adj = adj, font = 3)
}
wf_tabbar <- function(x, y, w, tabs, active = 1, h = 5.4) {
  tw <- w / length(tabs)
  for (i in seq_along(tabs)) {
    fill <- if (i == active) INK else "#E3E5EC"
    tcol <- if (i == active) "white" else "#3A3A44"
    rect(x + (i-1)*tw, y, x + i*tw, y + h, col = fill, border = LINE, lwd = 0.8)
    text(x + (i-0.5)*tw, y + h/2, tabs[i], cex = 0.56, col = tcol,
         font = if (i == active) 2 else 1)
  }
}
@

\section*{Executive summary}

PolyPaint is a working end-to-end system with unusually strong
\emph{verification culture}: cross-language drift tests, payload-contract
tests, a Docker runtime gate, fingerprint-stable wire formats, and a deploy
script that converges instead of hoping. The architecture's defining choice
is \textbf{radical buildlessness} --- one HTML file, one bash deployer, zips
of plain Python around native ARM binaries --- and most observed costs are
the predictable tax of that choice rather than accidents.

Three findings dominate:

\begin{enumerate}[leftmargin=1.4em]
  \item \textbf{The four-representation program pipeline (text
  $\to$ chips $\to$ tokens $\to$ C VM, mirrored again in the JS catalog) is
  the system's largest standing risk.} Every recent defect class --- alias
  drift, canonicalization gaps, layout-order flips --- is a synchronization
  failure between copies of the same fact. The fix is not a rewrite; it is
  generating the mirrors from one machine-readable catalog.
  \item \textbf{The UI is information-dense but workflow-poor.} It shows
  every knob of one stage at a time, while the actual creative loop
  (edit program $\to$ compute $\to$ preview $\to$ render $\to$ compare)
  crosses four tabs and lives partly in the user's memory. ``Constraining''
  is the right word: the layout mirrors the wire format, not the loop.
  \item \textbf{The biggest UI unlocks are cheap.} A persistent jobs rail, a
  click-to-inspect chip editor, side-by-side text$\,\leftrightarrow\,$chips,
  and an XY scrub pad driving the \emph{already-deployed} lores-preview
  Lambda would transform feel without touching the backend.
\end{enumerate}

