{
  "Comment": "PolyPaint render workflow — color, bilevel, coeff_bilevel pipelines. Wrapped in Parallel to catch States.Runtime from parameter resolution errors.",
  "StartAt": "WorkflowWrapper",
  "States": {

    "WorkflowWrapper": {
      "Type": "Parallel",
      "Branches": [{
        "StartAt": "CleanRender",
        "States": {

          "CleanRender": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": {
                "action": "phase",
                "job_id.$": "$.job_id",
                "task_id.$": "$.task_id",
                "run_id.$": "$.run_id",
                "run_started_at_ms.$": "$.run_started_at_ms",
                "mode.$": "$.mode",
                "phase": "plan",
                "phase_label": "Clean + plan"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "BuildPlan"
          },

          "BuildPlan": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${PlanFunctionArn}",
              "Payload.$": "$"
            },
            "ResultSelector": {
              "plan.$": "$.Payload.body"
            },
            "ResultPath": "$.plan_raw",
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ParsePlan"
          },

          "ParsePlan": {
            "Type": "Pass",
            "Parameters": {
              "job_id.$": "$.job_id",
              "run_id.$": "$.run_id",
              "run_started_at_ms.$": "$.run_started_at_ms",
              "task_id.$": "$.task_id",
              "mode.$": "$.mode",
              "params.$": "$.params",
              "plan.$": "States.StringToJson($.plan_raw.plan)"
            },
            "Next": "ModeChoice"
          },

          "ModeChoice": {
            "Type": "Choice",
            "Choices": [
              {"Variable": "$.mode", "StringEquals": "color", "Next": "ColorSolveScoreChoice"},
              {"Variable": "$.mode", "StringEquals": "bilevel", "Next": "BilevelRasterPhase"},
              {"Variable": "$.mode", "StringEquals": "coeff_bilevel", "Next": "CoeffRasterPhase"}
            ],
            "Default": "InnerFail"
          },

          "ColorSolveScoreChoice": {
            "Type": "Choice",
            "Choices": [
              {"Variable": "$.plan.solve_score.enabled", "BooleanEquals": true, "Next": "ColorSolveScoreClipPhase"}
            ],
            "Default": "ColorRasterPhase"
          },

          "ColorSolveScoreClipPhase": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": {
                "action": "phase",
                "job_id.$": "$.job_id",
                "task_id.$": "$.task_id",
                "run_id.$": "$.run_id",
                "run_started_at_ms.$": "$.run_started_at_ms",
                "mode.$": "$.mode",
                "phase": "solve_score_clip",
                "phase_label": "Solve score: clip",
                "expected": 1,
                "subtask_prefix.$": "States.Format('render_{}_solve_score_clip', $.run_id)"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ColorSolveScoreClipTask"
          },

          "ColorSolveScoreClipTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${SolveProximityFunctionArn}",
              "Payload": {
                "phase": "clip",
                "job_id.$": "$.job_id",
                "degree.$": "$.plan.calc.degree",
                "metric.$": "$.plan.solve_score.metric",
                "solve_score_chain.$": "$.plan.solve_score.chain",
                "solve_score_quantile.$": "$.plan.solve_score.quantile",
                "solve_score_omega.$": "$.plan.solve_score.omega",
                "solve_score_omega_enabled.$": "$.plan.solve_score.omega_enabled",
                "solve_score_threads.$": "$.plan.solve_score.threads",
                "lores_bin_key.$": "$.plan.calc.lores_bin_key",
                "lores_coeffs_key.$": "$.plan.calc.lores_coeffs_key",
                "lores_params_key.$": "$.plan.calc.lores_params_key",
                "n_coeffs.$": "$.plan.calc.n_coeffs",
                "root_transforms.$": "$.plan.params.root_transforms",
                "out_key.$": "$.plan.solve_score.clip_key",
                "task_id.$": "States.Format('render_{}_solve_score_clip', $.run_id)"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ColorSolveScoreHistPhase"
          },

          "ColorSolveScoreHistPhase": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": {
                "action": "phase",
                "job_id.$": "$.job_id",
                "task_id.$": "$.task_id",
                "run_id.$": "$.run_id",
                "run_started_at_ms.$": "$.run_started_at_ms",
                "mode.$": "$.mode",
                "phase": "solve_score_hist",
                "phase_label": "Solve score: hist",
                "expected.$": "$.plan.solve_score.item_count",
                "subtask_prefix.$": "States.Format('render_{}_solve_score_hist_', $.run_id)"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ColorSolveScoreHistMap"
          },

          "ColorSolveScoreHistMap": {
            "Type": "Map",
            "ItemsPath": "$.plan.solve_score.section_items",
            "MaxConcurrency": 10,
            "ItemSelector": {
              "phase": "hist",
                "job_id.$": "$.job_id",
                "chunk_idx.$": "$$.Map.Item.Value.chunk_idx",
                "section_idx.$": "$$.Map.Item.Value.section_idx",
                "section_count.$": "$$.Map.Item.Value.section_count",
                "metric.$": "$.plan.solve_score.metric",
              "solve_score_chain.$": "$.plan.solve_score.chain",
              "solve_score_quantile.$": "$.plan.solve_score.quantile",
              "solve_score_omega.$": "$.plan.solve_score.omega",
              "solve_score_omega_enabled.$": "$.plan.solve_score.omega_enabled",
              "solve_score_threads.$": "$.plan.solve_score.threads",
              "solve_score_hist_input_mode.$": "$.plan.solve_score.hist_input_mode",
              "solve_score_hist_retries.$": "$.plan.solve_score.hist_retries",
              "logical_section.$": "$.plan.solve_score.logical_section",
              "chunk_manifest.$": "$.plan.chunk_items",
              "bin_key.$": "$$.Map.Item.Value.bin_key",
              "coeffs_key.$": "$$.Map.Item.Value.coeffs_key",
              "coeffs_bin_size.$": "$$.Map.Item.Value.coeffs_bin_size",
              "params_key.$": "$$.Map.Item.Value.params_key",
              "params_step_start.$": "$$.Map.Item.Value.params_step_start",
              "params_step_count.$": "$$.Map.Item.Value.params_step_count",
              "step_start.$": "$$.Map.Item.Value.step_start",
              "step_count.$": "$$.Map.Item.Value.step_count",
              "n_coeffs.$": "$.plan.calc.n_coeffs",
              "degree.$": "$.plan.calc.degree",
              "clip_key.$": "$.plan.solve_score.clip_key",
              "hist_bins": 100,
              "root_transforms.$": "$.plan.params.root_transforms",
              "out_key.$": "States.Format('{}chunk_{}_hist.json', $.plan.solve_score.hist_prefix, $$.Map.Item.Value.chunk_idx)",
              "task_id.$": "States.Format('render_{}_solve_score_hist_{}', $.run_id, $$.Map.Item.Value.chunk_idx)"
            },
            "ItemProcessor": {
              "ProcessorConfig": {"Mode": "INLINE"},
              "StartAt": "SolveHistWorker",
              "States": {
                "SolveHistWorker": {
                  "Type": "Task",
                  "Resource": "arn:aws:states:::lambda:invoke",
                  "Parameters": { "FunctionName": "${SolveProximityFunctionArn}", "Payload.$": "$" },
                  "ResultPath": null,
                  "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
                  "End": true
                }
              }
            },
            "ResultPath": null,
            "Next": "ColorSolveScoreMergePhase"
          },

          "ColorSolveScoreMergePhase": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": {
                "action": "phase",
                "job_id.$": "$.job_id",
                "task_id.$": "$.task_id",
                "run_id.$": "$.run_id",
                "run_started_at_ms.$": "$.run_started_at_ms",
                "mode.$": "$.mode",
                "phase": "solve_score_merge",
                "phase_label": "Solve score: merge",
                "expected": 1,
                "subtask_prefix.$": "States.Format('render_{}_solve_score_merge', $.run_id)"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ColorSolveScoreMergeTask"
          },

          "ColorSolveScoreMergeTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${SolveProximityFunctionArn}",
              "Payload": {
                "phase": "merge",
                "job_id.$": "$.job_id",
                "n_chunks.$": "$.plan.calc.n_chunks",
                "metric.$": "$.plan.solve_score.metric",
                "solve_score_chain.$": "$.plan.solve_score.chain",
                "solve_score_quantile.$": "$.plan.solve_score.quantile",
                "solve_score_omega.$": "$.plan.solve_score.omega",
                "solve_score_omega_enabled.$": "$.plan.solve_score.omega_enabled",
              "solve_score_threads.$": "$.plan.solve_score.threads",
              "solve_score_merge_workers.$": "$.plan.solve_score.merge_workers",
                "n_chunks.$": "$.plan.solve_score.item_count",
                "hist_prefix.$": "$.plan.solve_score.hist_prefix",
                "clip_key.$": "$.plan.solve_score.clip_key",
                "out_key.$": "$.plan.solve_score.bins_key",
                "task_id.$": "States.Format('render_{}_solve_score_merge', $.run_id)"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ColorAssociatedPaletteChoice"
          },

          "ColorAssociatedPaletteChoice": {
            "Type": "Choice",
            "Choices": [
              {"Variable": "$.plan.associated_palette.mode", "StringEquals": "generated", "Next": "ColorAssociatedPalettePhase"}
            ],
            "Default": "ColorRasterPhase"
          },

          "ColorAssociatedPalettePhase": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": {
                "action": "phase",
                "job_id.$": "$.job_id",
                "task_id.$": "$.task_id",
                "run_id.$": "$.run_id",
                "run_started_at_ms.$": "$.run_started_at_ms",
                "mode.$": "$.mode",
                "phase": "associated_palette_chunk",
                "phase_label": "Associated palette",
                "expected.$": "$.plan.associated_palette.item_count",
                "subtask_prefix.$": "States.Format('render_{}_associated_palette_', $.run_id)"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ColorAssociatedPaletteMap"
          },

          "ColorAssociatedPaletteMap": {
            "Type": "Map",
            "ItemsPath": "$.plan.associated_palette.section_items",
            "MaxConcurrencyPath": "$.plan.associated_palette.chunk_workers",
            "ItemSelector": {
              "job_id.$": "$.job_id",
              "chunk_idx.$": "$$.Map.Item.Value.chunk_idx",
              "section_idx.$": "$$.Map.Item.Value.section_idx",
              "section_count.$": "$$.Map.Item.Value.section_count",
              "bin_key.$": "$$.Map.Item.Value.bin_key",
              "bin_size.$": "$$.Map.Item.Value.bin_size",
              "coeffs_key.$": "$$.Map.Item.Value.coeffs_key",
              "coeffs_bin_size.$": "$$.Map.Item.Value.coeffs_bin_size",
              "params_key.$": "$$.Map.Item.Value.params_key",
              "params_step_start.$": "$$.Map.Item.Value.params_step_start",
              "params_step_count.$": "$$.Map.Item.Value.params_step_count",
              "step_start.$": "$$.Map.Item.Value.step_start",
              "step_count.$": "$$.Map.Item.Value.step_count",
              "degree.$": "$.plan.calc.degree",
              "n_coeffs.$": "$.plan.calc.n_coeffs",
              "metric.$": "$.plan.associated_palette.metric",
              "solve_score_chain.$": "$.plan.associated_palette.score_chain",
              "solve_score_quantile.$": "$.plan.associated_palette.quantile",
              "solve_score_omega.$": "$.plan.associated_palette.omega",
              "solve_score_omega_enabled.$": "$.plan.associated_palette.omega_enabled",
              "root_transforms.$": "$.plan.params.root_transforms",
              "palette_chunk_threads.$": "$.plan.associated_palette.chunk_threads",
              "palette_chunk_input_mode.$": "$.plan.associated_palette.chunk_input_mode",
              "palette_chunk_retries.$": "$.plan.associated_palette.chunk_retries",
              "palette_chunk_workers.$": "$.plan.associated_palette.chunk_workers",
              "logical_section.$": "$.plan.associated_palette.logical_section",
              "chunk_manifest.$": "$.plan.chunk_items",
              "solve_score_bins_key.$": "$.plan.solve_score.bins_key",
              "score_key.$": "States.Format('{}{}.bin', $.plan.associated_palette.chunk_scores_prefix, $$.Map.Item.Value.chunk_idx)",
              "palette_bins_key.$": "States.Format('{}{}.bin', $.plan.associated_palette.chunk_bins_prefix, $$.Map.Item.Value.chunk_idx)",
              "meta_key.$": "States.Format('{}{}.json', $.plan.associated_palette.chunk_meta_prefix, $$.Map.Item.Value.chunk_idx)",
              "task_id.$": "States.Format('render_{}_associated_palette_{}', $.run_id, $$.Map.Item.Value.chunk_idx)"
            },
            "ItemProcessor": {
              "ProcessorConfig": {"Mode": "INLINE"},
              "StartAt": "AssociatedPaletteWorker",
              "States": {
                "AssociatedPaletteWorker": {
                  "Type": "Task",
                  "Resource": "arn:aws:states:::lambda:invoke",
                  "Parameters": { "FunctionName": "${PaletteChunkFunctionArn}", "Payload.$": "$" },
                  "ResultPath": null,
                  "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
                  "End": true
                }
              }
            },
            "ResultPath": null,
            "Next": "ColorAssociatedPaletteFinalizePhase"
          },

          "ColorAssociatedPaletteFinalizePhase": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": {
                "action": "phase",
                "job_id.$": "$.job_id",
                "task_id.$": "$.task_id",
                "run_id.$": "$.run_id",
                "run_started_at_ms.$": "$.run_started_at_ms",
                "mode.$": "$.mode",
                "phase": "associated_palette_finalize",
                "phase_label": "Associated palette: finalize",
                "expected": 1,
                "subtask_prefix.$": "States.Format('render_{}_associated_palette_finalize', $.run_id)"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ColorAssociatedPaletteFinalizeTask"
          },

          "ColorAssociatedPaletteFinalizeTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${PaletteFinalizeFunctionArn}",
              "Payload": {
                "job_id.$": "$.job_id",
                "task_id.$": "States.Format('render_{}_associated_palette_finalize', $.run_id)",
                "palette_id.$": "$.plan.associated_palette.palette_id",
                "N.$": "$.plan.calc.N",
                "times.$": "$.plan.calc.times",
                "degree.$": "$.plan.calc.degree",
                "metric.$": "$.plan.associated_palette.metric",
                "palette.$": "$.plan.associated_palette.palette",
                "solve_score_chain.$": "$.plan.associated_palette.score_chain",
                "solve_score_quantile.$": "$.plan.associated_palette.quantile",
                "solve_score_omega.$": "$.plan.associated_palette.omega",
                "solve_score_omega_enabled.$": "$.plan.associated_palette.omega_enabled",
                "render_execution.$": "$.plan.render_execution",
                "root_transforms.$": "$.plan.params.root_transforms",
                "image_key.$": "$.plan.associated_palette.image_key",
                "preview_key.$": "$.plan.associated_palette.preview_key",
                "meta_key.$": "$.plan.associated_palette.meta_key",
                "chunks_prefix.$": "$.plan.associated_palette.chunks_prefix",
                "chunk_scores_prefix.$": "$.plan.associated_palette.chunk_scores_prefix",
                "chunk_bins_prefix.$": "$.plan.associated_palette.chunk_bins_prefix",
                "chunk_meta_prefix.$": "$.plan.associated_palette.chunk_meta_prefix",
                "solve_score_prefix.$": "$.plan.solve_score.hist_prefix",
                "solve_score_clip_key.$": "$.plan.solve_score.clip_key",
                "solve_score_bins_key.$": "$.plan.solve_score.bins_key",
                "cleanup_solve_score_scratch": false
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ColorRasterPhase"
          },

          "ColorRasterPhase": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "${StatusFunctionArn}",
              "Payload": {
                "action": "phase",
                "job_id.$": "$.job_id",
                "task_id.$": "$.task_id",
                "run_id.$": "$.run_id",
                "run_started_at_ms.$": "$.run_started_at_ms",
                "mode.$": "$.mode",
                "phase": "raster",
                "phase_label": "Raster",
                "expected.$": "$.plan.raster.item_count",
                "subtask_prefix.$": "States.Format('render_{}_raster_', $.run_id)"
              }
            },
            "ResultPath": null,
            "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
            "Next": "ColorRasterItemsChoice"
          },

          "ColorRasterItemsChoice": {
            "Type": "Choice",
            "Choices": [
              {"Variable": "$.plan.raster.pixel_bin_fragment_mode", "StringEquals": "dense_grouped", "Next": "ColorRasterMapDense"}
            ],
            "Default": "ColorRasterMapSparse"
          },

          "ColorRasterMapSparse": {
            "Type": "Map",
            "ItemsPath": "$.plan.chunk_items",
            "MaxConcurrency": 10,
            "ItemSelector": {
              "job_id.$": "$.job_id",
              "chunk_idx.$": "$$.Map.Item.Value.chunk_idx",
              "task_id.$": "States.Format('render_{}_raster_{}', $.run_id, $$.Map.Item.Value.chunk_idx)",
              "bin_key.$": "$$.Map.Item.Value.bin_key",
              "coeffs_key.$": "$$.Map.Item.Value.coeffs_key",
              "coeffs_bin_size.$": "$$.Map.Item.Value.coeffs_bin_size",
              "params_key.$": "$$.Map.Item.Value.params_key",
              "params_step_start.$": "$$.Map.Item.Value.params_step_start",
              "params_step_count.$": "$$.Map.Item.Value.params_step_count",
              "step_start.$": "$$.Map.Item.Value.step_start",
              "step_count.$": "$$.Map.Item.Value.step_count",
              "n_coeffs.$": "$.plan.calc.n_coeffs",
              "width.$": "$.plan.grid.pix",
              "height.$": "$.plan.grid.pix",
              "tile_size.$": "$.plan.grid.tile_size",
              "n_tile_cols.$": "$.plan.grid.n_tile_cols",
              "n_tile_rows.$": "$.plan.grid.n_tile_rows",
              "center_re.$": "$.plan.viewport.center_re",
              "center_im.$": "$.plan.viewport.center_im",
              "scale.$": "$.plan.viewport.scale",
              "rotation.$": "$.plan.params.rotation",
              "degree.$": "$.plan.calc.degree",
              "color.$": "$.plan.params.color_mode",
              "match.$": "$.plan.params.match_mode",
              "palette.$": "$.plan.params.palette",
              "constant_color.$": "$.plan.params.constant_color",
              "root_transforms.$": "$.plan.params.root_transforms",
              "emit_pixel_bins.$": "$.plan.outputs.repalette_capable",
              "pixel_bins_drive_rgb.$": "$.plan.outputs.pixel_bins_drive_rgb",
              "solve_score_bins_key.$": "$.plan.solve_score.bins_key",
              "saved_palette_bins_prefix.$": "$.plan.saved_palette.chunk_bins_prefix",
              "saved_palette_bins_key.$": "States.Format('{}{}.bin', $.plan.saved_palette.chunk_bins_prefix, $$.Map.Item.Value.chunk_idx)",
              "solve_metric.$": "$.plan.solve_score.metric",
              "solve_score_chain.$": "$.plan.solve_score.chain",
              "solve_score_quantile.$": "$.plan.solve_score.quantile",
              "solve_score_omega.$": "$.plan.solve_score.omega",
              "solve_score_omega_enabled.$": "$.plan.solve_score.omega_enabled",
              "raster_function_name.$": "$.plan.raster.function_name",
              "raster_mt_threads.$": "$.plan.raster.threads",
              "raster_input_mode.$": "$.plan.raster.input_mode",
              "raster_sectioned_retries.$": "$.plan.raster.sectioned_retries",
              "pixel_bin_fragment_mode.$": "$.plan.raster.pixel_bin_fragment_mode",
              "raster_bin_group_size.$": "$.plan.raster.raster_bin_group_size"
            },
            "ItemProcessor": {
              "ProcessorConfig": {"Mode": "INLINE"},
              "StartAt": "RasterWorkerSparse",
              "States": {
                "RasterWorkerSparse": {
                  "Type": "Task",
                  "Resource": "arn:aws:states:::lambda:invoke",
                  "Parameters": { "FunctionName.$": "$.raster_function_name", "Payload.$": "$" },
                  "ResultPath": null,
                  "Retry": [{"ErrorEquals": ["Lambda.ServiceException","Lambda.AWSLambdaException","Lambda.SdkClientException"], "IntervalSeconds": 2, "BackoffRate": 2.0, "MaxAttempts": 3}],
                  "End": true
                }
              }
            },
            "ResultPath": null,
            "Next": "ColorFinalizePhase"
          },

          "ColorRasterMapDense": {
            "Type": "Map",
            "ItemsPath": "$.plan.raster_items",
            "MaxConcurrency": 10,
            "ItemSelector": {
              "job_id.$": "$.job_id",
              "group_idx.$": "$$.Map.Item.Value.group_idx",
              "chunk_idx.$": "$$.Map.Item.Value.chunk_idx",
              "task_id.$": "States.Format('render_{}_raster_{}', $.run_id, $$.Map.Item.Value.group_idx)",
