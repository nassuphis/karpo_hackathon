                "cfpv.$": "$.plan.pipeline.cfpv",
                "solver_mode.$": "$.plan.solve.mode",
                "solver_iters.$": "$.plan.solve.iters",
                "n_coeffs.$": "$.post.n_coeffs",
                "degree.$": "$.post.degree",
                "fused_threads.$": "$.plan.fused.threads"
              },
              "ItemProcessor": {
                "ProcessorConfig": {
                  "Mode": "INLINE"
                },
                "StartAt": "FusedChunkWorker",
                "States": {
                  "FusedChunkWorker": {
                    "Type": "Task",
                    "Resource": "arn:aws:states:::lambda:invoke",
                    "Parameters": {
                      "FunctionName": "${FusedChunkFunctionArn}",
                      "Payload.$": "$"
                    },
                    "ResultSelector": {
                      "body.$": "States.StringToJson($.Payload.body)"
                    },
                    "OutputPath": "$.body",
                    "Retry": [
                      {
                        "ErrorEquals": [
                          "Lambda.ServiceException",
                          "Lambda.AWSLambdaException",
                          "Lambda.SdkClientException"
                        ],
                        "IntervalSeconds": 2,
                        "BackoffRate": 2.0,
                        "MaxAttempts": 3
                      }
                    ],
                    "End": true
                  }
                }
              },
              "ResultPath": null,
              "Next": "SaveMetadataPhase"
            },
            "SolvePhase": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${StatusFunctionArn}",
                "Payload": {
                  "action": "phase",
                  "job_id.$": "$.job_id",
                  "task_id.$": "$.task_id",
                  "run_id.$": "$.run_id",
                  "run_started_at_ms.$": "$.run_started_at_ms",
                  "mode.$": "$.mode",
                  "solver_mode.$": "$.plan.solve.mode",
                  "phase": "solve",
                  "phase_label": "Solve",
                  "expected.$": "$.plan.compute.n_chunks",
                  "subtask_prefix.$": "$.plan.solve.task_prefix",
                  "execution_arn.$": "$$.Execution.Id"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "SolveMap"
            },
            "SolveMap": {
              "Type": "Map",
              "ItemsPath": "$.plan.chunk_items",
              "MaxConcurrency": 50,
              "ItemSelector": {
                "job_id.$": "$.job_id",
                "chunk_idx.$": "$$.Map.Item.Value.chunk_idx",
                "task_id.$": "$$.Map.Item.Value.solve_task_id",
                "coeffs_key.$": "$$.Map.Item.Value.coeffs_key",
                "n_coeffs.$": "$.post.n_coeffs",
                "n_steps.$": "$$.Map.Item.Value.step_count",
                "s3_key.$": "$$.Map.Item.Value.bin_key",
                "solve_mode.$": "$.plan.solve.bin_mode",
                "max_iter.$": "$.plan.solve.iters",
                "solver_function_name.$": "$.plan.solve.function_name"
              },
              "ItemProcessor": {
                "ProcessorConfig": {
                  "Mode": "INLINE"
                },
                "StartAt": "SolveWorker",
                "States": {
                  "SolveWorker": {
                    "Type": "Task",
                    "Resource": "arn:aws:states:::lambda:invoke",
                    "Parameters": {
                      "FunctionName.$": "$.solver_function_name",
                      "Payload.$": "$"
                    },
                    "ResultSelector": {
                      "body.$": "States.StringToJson($.Payload.body)"
                    },
                    "OutputPath": "$.body",
                    "Retry": [
                      {
                        "ErrorEquals": [
                          "Lambda.ServiceException",
                          "Lambda.AWSLambdaException",
                          "Lambda.SdkClientException",
                          "Lambda.TooManyRequestsException"
                        ],
                        "IntervalSeconds": 2,
                        "BackoffRate": 2.0,
                        "MaxAttempts": 3
                      }
                    ],
                    "End": true
                  }
                }
              },
              "ResultPath": null,
              "Next": "SaveMetadataPhase"
            },
            "SaveMetadataPhase": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${StatusFunctionArn}",
                "Payload": {
                  "action": "phase",
                  "job_id.$": "$.job_id",
                  "task_id.$": "$.task_id",
                  "run_id.$": "$.run_id",
                  "run_started_at_ms.$": "$.run_started_at_ms",
                  "mode.$": "$.mode",
                  "solver_mode.$": "$.plan.solve.mode",
                  "phase": "save_metadata",
                  "phase_label": "Save metadata",
                  "execution_arn.$": "$$.Execution.Id"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "SaveMetadataTask"
            },
            "SaveMetadataTask": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${PlanFunctionArn}",
                "Payload": {
                  "action": "finalize_metadata",
                  "job_id.$": "$.job_id",
                  "plan.$": "$.plan",
                  "post.$": "$.post",
                  "lores_solve.$": "$.lores_solve.body",
                  "task_prefix.$": "$.plan.solve.task_prefix",
                  "expected.$": "$.plan.compute.n_chunks"
                }
              },
              "ResultSelector": {
                "body.$": "States.StringToJson($.Payload.body)"
              },
              "ResultPath": "$.save_metadata",
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "ReportDone"
            },
            "ReportDone": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
              "Parameters": {
                "FunctionName": "${StatusFunctionArn}",
                "Payload": {
                  "action": "done",
                  "job_id.$": "$.job_id",
                  "task_id.$": "$.task_id",
                  "run_id.$": "$.run_id",
                  "run_started_at_ms.$": "$.run_started_at_ms",
                  "mode.$": "$.mode",
                  "solver_mode.$": "$.plan.solve.mode",
                  "calc_key.$": "$.save_metadata.body.calc_key",
                  "degree.$": "$.save_metadata.body.degree",
                  "n_chunks.$": "$.save_metadata.body.n_chunks",
                  "solver.$": "$.save_metadata.body.solver",
                  "execution_arn.$": "$$.Execution.Id"
                }
              },
              "ResultPath": null,
              "Retry": [
                {
                  "ErrorEquals": [
                    "Lambda.ServiceException",
                    "Lambda.AWSLambdaException",
                    "Lambda.SdkClientException"
                  ],
                  "IntervalSeconds": 2,
                  "BackoffRate": 2.0,
                  "MaxAttempts": 3
                }
              ],
              "Next": "InnerSucceed"
            },
            "InnerSucceed": {
              "Type": "Succeed"
            }
          }
        }
      ],
      "ResultPath": null,
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error_info",
          "Next": "ReportError"
        }
      ],
      "Next": "Succeed"
    },
    "Succeed": {
      "Type": "Succeed"
    },
    "ReportError": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${StatusFunctionArn}",
        "Payload": {
          "action": "error",
          "job_id.$": "$.job_id",
          "task_id.$": "$.task_id",
          "run_id.$": "$.run_id",
          "mode.$": "$.mode",
          "solver_mode.$": "$.params.solver_mode",
          "run_started_at_ms.$": "$.run_started_at_ms",
          "Error.$": "$.error_info.Error",
          "Cause.$": "$.error_info.Cause",
          "execution_arn.$": "$$.Execution.Id"
        }
      },
      "ResultPath": null,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "BackoffRate": 2.0,
          "MaxAttempts": 3
        }
      ],
      "Next": "Fail"
    },
    "Fail": {
      "Type": "Fail",
      "Error": "ComputeFailed",
      "Cause": "See DDB run row for details"
    }
  }
}
