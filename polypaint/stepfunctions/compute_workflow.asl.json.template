                          "Lambda.AWSLambdaException",
                          "Lambda.SdkClientException"
                        ],
                        "IntervalSeconds": 2,
                        "BackoffRate": 2.0,
                        "MaxAttempts": 3
                      }
                    ],
                    "End": true
                  }
                }
              },
              "ResultPath": null,
              "Next": "PostCoeffgenPhase"
            },
            "PostCoeffgenPhase": {
              "Type": "Task",
              "Resource": "arn:aws:states:::lambda:invoke",
